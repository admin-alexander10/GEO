# Configuración del Servidor
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion_qgeorescue2026

# Configuración de Base de Datos PostgreSQL con PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_quantum_georescue
DB_USER=postgres
DB_PASSWORD=omar123

# Configuración de Proveedores Geoespaciales
GEOAPIFY_API_KEY=d055c0b4-9aad-4446-b964-ffb91a31c15a

# Configuración del módulo antirrobo / correo de alertas
APP_BASE_URL=http://localhost:3000
# Déjalo vacío si aún no tienes correo saliente: las fotos solo se guardan en la cuenta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=tu-usuario-smtp
SMTP_PASSWORD=tu-password-smtp
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@georescue.local
# Horas en que el correo de seguridad no se puede cambiar tras un SOS, pánico o evidencia
SECURITY_EMAIL_LOCK_HOURS=24

# Configuración de pagos reales (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=price_pro_demo
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_demo
# subscription = precios recurrentes (mensual); payment = pago único
STRIPE_CHECKOUT_MODE=subscription

# Datos de cobro que se muestran en el formulario de pago (Yape / Plin / transferencia)
PAYMENT_ACCOUNT_HOLDER=GEORESCUE IA (cuenta de ejemplo)
PAYMENT_YAPE_NUMBER=999 999 999
PAYMENT_PLIN_NUMBER=999 999 999
PAYMENT_BANK_ACCOUNT=BCP 000-0000000-0-00 (ejemplo)


# Canal SMS firmado (ver docs/CONTRATO_SMS.md). Los secretos reales no se suben al repositorio.
SMS_PROVIDER=console
SMS_WEBHOOK_SECRET=
SMS_OTP_PEPPER=
SMS_DEVICE_ENCRYPTION_KEY=
# Solo desarrollo: muestra en la terminal del backend el código OTP en lugar de enviarlo.
SMS_CONSOLE_PRINT_MESSAGES=false
