# Copia este archivo como deploy/.env en el SERVIDOR y rellénalo. NO lo subas a git.
# Dominios (si no tienes uno, usa sslip.io con la IP del servidor con guiones):
#   IP 203.0.113.10  ->  WEB_DOMAIN=203-0-113-10.sslip.io   API_DOMAIN=api.203-0-113-10.sslip.io
WEB_DOMAIN=
API_DOMAIN=
ALLOWED_ORIGINS=https://CAMBIA_POR_TU_WEB_DOMAIN
APP_BASE_URL=https://CAMBIA_POR_TU_WEB_DOMAIN

DB_NAME=db_quantum_georescue
DB_USER=postgres
DB_PASSWORD=

SECRET_KEY=
GEOAPIFY_API_KEY=

# SMS: console = sin proveedor (el OTP se lee en los logs). Cambia a twilio cuando lo tengas.
SMS_PROVIDER=console
SMS_CONSOLE_PRINT_MESSAGES=true
SMS_WEBHOOK_SECRET=
SMS_OTP_PEPPER=
SMS_DEVICE_ENCRYPTION_KEY=
